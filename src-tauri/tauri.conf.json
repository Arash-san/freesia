{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freesia",
  "version": "4.0.0-beta.1",
  "identifier": "com.freesia.app",
  "build": { "frontendDist": "../src/renderer" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null, "freezePrototype": true }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../assets/icon.ico", "../assets/icon.png"],
    "shortDescription": "Voice dictation with Freesia Cloud, Gemini, or local models",
    "category": "Productivity",
    "windows": { "nsis": { "displayLanguageSelector": false, "installMode": "currentUser" } }
  }
}
