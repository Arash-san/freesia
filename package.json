{
  "name": "freesia",
  "version": "3.0.1",
  "description": "Freesia - free, open-source voice dictation for Windows. Self-hosted, on-device or Gemini speech recognition. Speak freely. Write beautifully.",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "Freesia Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/arash-san/freesia.git"
  },
  "bugs": {
    "url": "https://github.com/arash-san/freesia/issues"
  },
  "homepage": "https://github.com/arash-san/freesia#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:native": "node test/run-native.cjs",
    "build": "electron-builder",
    "package": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always",
    "shots": "node test/run-shots.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1"
  },
  "build": {
    "appId": "com.freesia.app",
    "productName": "Freesia",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/installer-header.bmp",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "arash-san",
        "repo": "freesia",
        "releaseType": "release"
      }
    ]
  }
}
