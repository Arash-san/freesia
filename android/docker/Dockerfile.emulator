# Headless Android 16 emulator for smoke tests (needs --device /dev/kvm).
FROM freesia-android-build:1

RUN apt-get update \
 && apt-get install -y --no-install-recommends libpulse0 libgl1 libnss3 libxcomposite1 libxcursor1 libxi6 \
      libxtst6 libasound2t64 libxdamage1 libxrandr2 libxkbfile1 libdbus-1-3 python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

# Android 16 (API 36) google_apis x86_64: the same OS generation as the Galaxy S25 Edge
RUN yes | sdkmanager --licenses > /dev/null \
 && sdkmanager --install "emulator" "system-images;android-36;google_apis;x86_64" > /dev/null \
 && echo no | avdmanager create avd -n smoke -k "system-images;android-36;google_apis;x86_64" -d pixel_7 \
 && printf 'hw.keyboard=no\nhw.ramSize=4096\nhw.gpu.enabled=yes\nhw.gpu.mode=swiftshader_indirect\nhw.audioInput=yes\nhw.audioOutput=no\n' >> /root/.android/avd/smoke.avd/config.ini

# Python gRPC client for the emulator controller: smoke.sh speaks into the virtual
# microphone with injectAudio (docker/inject_audio.py)
RUN python3 -m venv /opt/grpc \
 && /opt/grpc/bin/pip install -q grpcio grpcio-tools \
 && mkdir -p /opt/emu-grpc \
 && /opt/grpc/bin/python -m grpc_tools.protoc -I${ANDROID_HOME}/emulator/lib --python_out=/opt/emu-grpc \
      --grpc_python_out=/opt/emu-grpc emulator_controller.proto

ENV PATH=${PATH}:${ANDROID_HOME}/emulator
